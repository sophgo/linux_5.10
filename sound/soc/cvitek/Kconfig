#
# CVITEK Audio Sound SoC drivers
#

config SND_CVITEK_I2S
    tristate "CVITEK I2S Device Driver"
    depends on CLKDEV_LOOKUP
	select SND_SOC_GENERIC_DMAENGINE_PCM
    help
     Say y or m if you want to add support for I2S driver for
     CVITEK I2S device. The device supports up to maximum of
     2 channels each for play and record.
     Say N, if not support

config SND_CVITEK_I2S_SUBSYS
    tristate "CVITEK I2S TDM sub-system driver"
    depends on SND
    help
     Enable CVITEK I2S TDM sub-system driver to do I2S TDM configuration.
     One needs to set this sub-system for multi-record at the same time
     or TX/RX simultaneously. ex. set I2S0 as RX and I2S1 as TX.
     Due to 1 I2S IP only has 1 FIFO, one must do this setting.

# PDM Configuration
config SND_SOC_CVITEK_PDM
    tristate "CVITEK PDM codec driver"
    depends on SND
    help
     Say y or m if you want to add support for CVITEK PDM codec driver.
     The device supports digital external MICs.
     Say N, if not support

config SND_SOC_CVITEK_CARD_PDM
    tristate "CVITEK PDM sound card driver"
    depends on SND
    select SND_CVITEK_I2S
    select SND_CVITEK_I2S_SUBSYS
    select SND_SOC_CVITEK_PDM
    help
     Say Y or M if you want to add support for CVITEK PDM sound card.
     This will enable the PDM sound card along with required I2S and
     PDM codec drivers.
     Say N, if not support

